DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&connection_limit=1"
# Pour Vercel Postgres (recommandé) : utilisez POSTGRES_PRISMA_URL auto-généré
# Pour Supabase : postgresql://postgres.[ref]:[password]@[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# ⚠️ Production : configurer via Vercel Dashboard > Environment Variables

AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Générer : openssl rand -base64 32

NEXTAUTH_URL="http://localhost:3000"
# Production : https://tdb-crm.vercel.app

NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production : https://tdb-crm.vercel.app

# Emails (optionnel — sans clé : activité loggée seulement)
RESEND_API_KEY=""
RESEND_FROM="T&S CRM <onboarding@resend.dev>"

# Stripe Checkout (optionnel)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Bookflow webhook (optionnel)
BOOKFLOW_WEBHOOK_SECRET=""

# Afficher les comptes démo sur /login (désactivé en production par défaut)
NEXT_PUBLIC_SHOW_DEMO_LOGIN="false"
