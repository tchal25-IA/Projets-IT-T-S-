generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  ASSOCIE
  DIRECTION_VF
  DIRECTION_BOOKFLOW
  COMMERCIAL
  APPORTEUR
  ADMIN
}

enum LeadStatus {
  NOUVEAU
  CONTACTE
  QUALIFIE
  RDV_PLANIFIE
  PROPOSITION
  CLOSE
  PERDU
}

enum AccountStatus {
  // Renommé de ClientStatus pour alignement Salesforce
  EN_LIVRAISON
  ACTIF
  MAINTENANCE
}

enum OpportunityStage {
  // Nouveau : remplace implicitement BillingStatus
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum BillingStatus {
  // Conservé pour compatibilité, mapping vers OpportunityStage progressif
  DEVIS
  A_FACTURER
  FACTURE
  PAYE
}

enum ActivityType {
  APPEL
  EMAIL
  NOTE
  RDV
  STATUT
  IMPORT
  SYSTEM
}

enum CommissionStatus {
  CALCULEE
  A_VERSER
  VERSEE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum SavedViewEntity {
  LEAD
  ACCOUNT
  OPPORTUNITY
}

enum OfferingKind {
  ONE_SHOT
  SUBSCRIPTION
  MAINTENANCE
  OTHER
}

enum BillingPeriod {
  NONE
  MONTHLY
  YEARLY
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DECIMAL
  DATE
  DATETIME
  BOOLEAN
  PICKLIST
  MULTIPICKLIST
  REFERENCE
  URL
  EMAIL
  PHONE
}

enum ModuleType {
  SALES
  MARKETING
  SERVICE
  CUSTOM_OBJECTS
  ADVANCED_REPORTS
  API_ACCESS
  INTEGRATIONS
}

// ============================================================================
// MULTI-TENANT CORE
// ============================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?
  settings  Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                User[]
  leads                Lead[]
  accounts             Account[]
  contacts             Contact[]
  opportunities        Opportunity[]
  activities           Activity[]
  notifications        Notification[]
  tasks                Task[]
  savedViews           SavedView[]
  fieldHistories       FieldHistory[]
  quotas               Quota[]
  commissions          Commission[]
  products             Product[]
  productOfferings     ProductOffering[]
  commissionRules      CommissionRule[]
  crmSettings          CrmSetting[]
  customObjects        CustomObject[]
  customFields         CustomField[]
  customFieldValues    CustomFieldValue[]
  moduleEntitlements   ModuleEntitlement[]
  leadInterests        LeadInterest[]

  @@index([active])
  @@index([slug])
}

// ============================================================================
// USER & AUTH
// ============================================================================

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  fullName       String
  role           Role
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadsApportes    Lead[]         @relation("Apporteur")
  leadsCommerciaux Lead[]         @relation("Commercial")
  activities       Activity[]
  notifications    Notification[]
  commissions      Commission[]
  tasks            Task[]
  savedViews       SavedView[]
  fieldHistories   FieldHistory[]
  quotas           Quota[]

  @@index([organizationId, active])
  @@index([organizationId, role])
}

// ============================================================================
// CRM ENTITIES (Business Objects)
// ============================================================================

model Lead {
  id             String     @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  companyName    String
  contactName    String?
  email          String?
  phone          String?
  website        String?
  status         LeadStatus @default(NOUVEAU)
  source         String?
  customData     Json       @default("{}")
  estimatedValue Float?
  nextCallAt     DateTime?
  closedAt       DateTime?
  importedAt     DateTime?
  lastImportedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  apporteurId  String?
  apporteur    User?    @relation("Apporteur", fields: [apporteurId], references: [id])
  commercialId String?
  commercial   User?    @relation("Commercial", fields: [commercialId], references: [id])
  accountId    String?
  account      Account? @relation(fields: [accountId], references: [id])

  activities    Activity[]
  opportunities Opportunity[]
  commissions   Commission[]
  tasks         Task[]
  interests     LeadInterest[]

  @@index([organizationId, status])
  @@index([organizationId, productId])
  @@index([organizationId, commercialId])
  @@index([organizationId, apporteurId])
  @@index([organizationId, nextCallAt])
  @@index([organizationId, email])
  @@index([organizationId, website])
}

model Account {
  // Renommé de Client pour alignement Salesforce
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  companyName    String
  website        String?
  phone          String?
  email          String?
  status         AccountStatus @default(EN_LIVRAISON)
  notes          String?
  qualification  Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  leads         Lead[]
  contacts      Contact[]
  opportunities Opportunity[]
  commissions   Commission[]
  tasks         Task[]

  @@index([organizationId, status])
  @@index([organizationId, companyName])
}

model Contact {
  // Nouveau : sépare les contacts des accounts
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  firstName      String?
  lastName       String
  email          String?
  phone          String?
  mobilePhone    String?
  title          String?
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  @@index([organizationId, accountId])
  @@index([organizationId, email])
}

model Opportunity {
  // Évolution de DealLine vers concept Salesforce Opportunity
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  amount          Float
  stage           OpportunityStage @default(QUALIFICATION)
  closeDate       DateTime?
  probability     Int?             @default(0)
  description     String?
  isRecurring     Boolean          @default(false)
  
  // Legacy billing fields (compatibilité)
  billingStatus   BillingStatus?
  invoiceNumber   String?
  stripeSessionId String?
  paidAt          DateTime?
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  offeringId String?
  offering   ProductOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, stage])
  @@index([organizationId, accountId])
  @@index([organizationId, leadId])
  @@index([organizationId, closeDate])
  @@index([stripeSessionId])
  @@index([offeringId])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  type      ActivityType
  note      String
  createdAt DateTime     @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  @@index([organizationId, leadId])
  @@index([organizationId, createdAt])
}

model Commission {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  label       String
  roleLabel   String
  ratePercent Float
  amountHt    Float
  status      CommissionStatus @default(CALCULEE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([organizationId, accountId])
  @@index([organizationId, userId])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  title     String
  dueAt     DateTime?
  doneAt    DateTime?
  priority  TaskPriority @default(MEDIUM)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, doneAt])
  @@index([organizationId, dueAt])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, read])
}

// ============================================================================
// PRODUCT CATALOG
// ============================================================================

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  slug        String
  name        String
  description String?
  fieldSchema Json
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads     Lead[]
  offerings ProductOffering[]

  @@unique([organizationId, slug])
  @@index([organizationId, active])
}

model ProductOffering {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  code          String?
  kind          OfferingKind  @default(OTHER)
  amountHt      Float?
  billingPeriod BillingPeriod @default(NONE)
  active        Boolean       @default(true)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  opportunities Opportunity[]

  @@index([organizationId, productId, active])
}

model CommissionRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  roleKey     String
  label       String
  ratePercent Float
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, roleKey])
}

// ============================================================================
// METADATA & EXTENSIBILITY
// ============================================================================

model CustomObject {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name        String
  apiName     String
  label       String
  pluralLabel String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customFields CustomField[]

  @@unique([organizationId, apiName])
  @@index([organizationId, isActive])
}

model CustomField {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  objectType     String
  apiName        String
  label          String
  fieldType      FieldType
  isRequired     Boolean   @default(false)
  defaultValue   String?
  helpText       String?
  picklistValues Json?
  referenceTo    String?
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customObjectId String?
  customObject   CustomObject? @relation(fields: [customObjectId], references: [id], onDelete: Cascade)

  values CustomFieldValue[]

  @@unique([organizationId, objectType, apiName])
  @@index([organizationId, objectType, isActive])
}

model CustomFieldValue {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  
  recordType    String
  recordId      String
  
  valueText     String?
  valueNumber   Float?
  valueDate     DateTime?
  valueBoolean  Boolean?
  valueJson     Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customFieldId, recordId])
  @@index([organizationId, recordType, recordId])
  @@index([customFieldId, recordId])
}

model ModuleEntitlement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  moduleType ModuleType
  isEnabled  Boolean    @default(true)
  quota      Int?
  enabledAt  DateTime   @default(now())
  expiresAt  DateTime?
  notes      String?

  @@unique([organizationId, moduleType])
  @@index([organizationId, isEnabled])
}

// ============================================================================
// SUPPORT MODELS
// ============================================================================

model LeadInterest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  productSlug String
  createdAt   DateTime @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, productSlug])
  @@index([organizationId, productSlug])
}

model SavedView {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name      String
  entity    SavedViewEntity @default(LEAD)
  filters   Json            @default("{}")
  isShared  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, entity])
}

model FieldHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  entity    String
  entityId  String
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, entity, entityId, createdAt])
}

model Quota {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  yearMonth    String
  targetCloses Int      @default(0)
  targetCa     Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, yearMonth])
  @@index([organizationId, yearMonth])
}

model CrmSetting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([organizationId, key])
  @@index([organizationId])
}
